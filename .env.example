NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5000

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/restaurant_management"

JWT_ACCESS_SECRET="your-access-secret"
JWT_REFRESH_SECRET="your-refresh-secret"

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL="redis://localhost:6379"
LOG_LEVEL="info"
BCRYPT_ROUNDS=10

WHATSAPP_VERIFY_TOKEN="replace-with-your-verify-token-min-16-chars"
WHATSAPP_WEBHOOK_SECRET="replace-with-your-webhook-secret-min-16-chars"
WHATSAPP_API_TOKEN="replace-with-your-whatsapp-api-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-your-phone-number-id"