generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  ENDED
  FORCE_LOGGED_OUT
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum MenuStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderSource {
  WHATSAPP
  QR
  WEBSITE
  CASHIER
  PHONE
}

enum OrderType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

model Restaurant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  email       String?
  phone       String?
  description String?
  logoUrl     String?          @map("logo_url")
  currency    String?
  timezone    String?
  status      RestaurantStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  branches               Branch[]
  roles                  Role[]
  rolePermissions        RolePermission[]
  employees              Employee[]
  sessions               Session[]
  employeeBranchAccesses EmployeeBranchAccess[]
  workingHours           WorkingHours[]
  branchSettings         BranchSettings[]
  categories             Category[]
  products               Product[]
  productModifiers       ProductModifier[]
  tables                 RestaurantTable[]
  orders                 Order[]
  orderItems             OrderItem[]
  orderStatusHistories   OrderStatusHistory[]
  idempotencyKeys        IdempotencyKey[]
  customers              Customer[]
  customerAddresses      CustomerAddress[]

  @@index([status])
  @@map("restaurants")
}

model Branch {
  id           String       @id @default(cuid())
  restaurantId String       @map("restaurant_id")
  name         String
  code         String
  address      String?
  phone        String?
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  street       String?
  city         String?
  state        String?
  postalCode   String?      @map("postal_code")
  status       BranchStatus @default(ACTIVE)
  isMain       Boolean      @default(false) @map("is_main")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employees      Employee[]
  branchAccesses EmployeeBranchAccess[]
  workingHours   WorkingHours[]
  settings       BranchSettings?
  tables         RestaurantTable[]
  orders         Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("branches")
}

model WorkingHours {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  branchId     String   @map("branch_id")
  day          Weekday
  openTime     String   @map("open_time")
  closeTime    String   @map("close_time")
  isOpen       Boolean  @default(true) @map("is_open")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, day])
  @@index([restaurantId])
  @@index([branchId])
  @@map("working_hours")
}

model BranchSettings {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  branchId     String   @unique @map("branch_id")
  currency     String?
  timezone     String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("branch_settings")
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  name         String
  description  String?
  sortOrder    Int        @default(0) @map("sort_order")
  status       MenuStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("categories")
}

model Product {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  categoryId   String     @map("category_id")
  name         String
  description  String?
  price        Decimal    @db.Decimal(10, 2)
  imageUrl     String?    @map("image_url")
  isAvailable  Boolean    @default(true) @map("is_available")
  status       MenuStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifiers  ProductModifier[]
  orderItems OrderItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, status])
  @@map("products")
}

model ProductModifier {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  productId    String    @map("product_id")
  name         String
  priceDelta   Decimal   @default(0.00) @map("price_delta") @db.Decimal(10, 2)
  isRequired   Boolean   @default(false) @map("is_required")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([productId])
  @@map("product_modifiers")
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  branchId     String      @map("branch_id")
  label        String
  capacity     Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  qrToken      String      @unique @map("qr_token")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([branchId, label])
  @@index([restaurantId])
  @@index([branchId])
  @@index([branchId, status])
  @@map("tables")
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    Int           @map("order_number")
  restaurantId   String        @map("restaurant_id")
  branchId       String        @map("branch_id")
  source         OrderSource   @default(CASHIER)
  type           OrderType     @default(DINE_IN)
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod  PaymentMethod? @map("payment_method")
  customerId     String?       @map("customer_id")
  tableId        String?       @map("table_id")
  couponId       String?       @map("coupon_id")
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  cancelReason   String?       @map("cancel_reason")
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table         RestaurantTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([branchId, orderNumber])
  @@index([restaurantId])
  @@index([branchId])
  @@index([restaurantId, branchId, status])
  @@index([branchId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  restaurantId      String   @map("restaurant_id")
  orderId            String   @map("order_id")
  productId         String   @map("product_id")
  productName       String   @map("product_name")
  quantity          Int      @default(1)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(10, 2)
  notes             String?
  selectedModifiers Json?    @map("selected_modifiers")
  createdAt         DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  orderId      String      @map("order_id")
  fromStatus   OrderStatus? @map("from_status")
  toStatus     OrderStatus @map("to_status")
  changedById  String?     @map("changed_by_id")
  reason       String?
  createdAt    DateTime    @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@map("order_status_history")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  key          String
  responseBody Json     @map("response_body")
  statusCode   Int      @default(201) @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("idempotency_keys")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  name         String
  description  String?
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  employees   Employee[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([restaurantId])
  @@index([roleId])
  @@map("role_permissions")
}

model Employee {
  id           String         @id @default(cuid())
  restaurantId String         @map("restaurant_id")
  branchId     String         @map("branch_id")
  roleId       String         @map("role_id")
  name         String
  email        String
  phone        String?
  passwordHash String         @map("password_hash")
  status       EmployeeStatus @default(ACTIVE)
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  role           Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions       Session[]
  branchAccesses EmployeeBranchAccess[]

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, status])
  @@map("employees")
}

model Session {
  id               String        @id @default(cuid())
  restaurantId     String        @map("restaurant_id")
  employeeId       String        @map("employee_id")
  device           String
  ipAddress        String        @map("ip_address")
  status           SessionStatus @default(ACTIVE)
  refreshTokenHash String        @unique @map("refresh_token_hash")
  loginAt          DateTime      @default(now()) @map("login_at")
  logoutAt         DateTime?     @map("logout_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, employeeId, status])
  @@map("sessions")
}

model EmployeeBranchAccess {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  employeeId   String   @map("employee_id")
  branchId     String   @map("branch_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  @@index([restaurantId])
  @@index([employeeId])
  @@map("employee_branch_accesses")
}

model Customer {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  name         String
  phone        String
  email        String?
  notes        String?
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  addresses  CustomerAddress[]
  orders     Order[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, name])
  @@index([restaurantId, phone])
  @@map("customers")
}

model CustomerAddress {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  customerId   String    @map("customer_id")
  label        String    @default("HOME")
  street       String?
  city         String?
  state        String?
  postalCode   String?   @map("postal_code")
  isDefault    Boolean   @default(false) @map("is_default")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([customerId])
  @@map("customer_addresses")
}