generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  ENDED
  FORCE_LOGGED_OUT
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum MenuStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum TableSessionOrderStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderSource {
  WHATSAPP
  QR
  WEBSITE
  CASHIER
  PHONE
}

enum OrderType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

model Restaurant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  email       String?
  phone       String?
  description String?
  logoUrl     String?          @map("logo_url")
  currency    String?
  timezone    String?
  status      RestaurantStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  branches               Branch[]
  roles                  Role[]
  rolePermissions        RolePermission[]
  employees              Employee[]
  sessions               Session[]
  employeeBranchAccesses EmployeeBranchAccess[]
  workingHours           WorkingHours[]
  branchSettings         BranchSettings[]
  categories             Category[]
  products               Product[]
  productModifiers       ProductModifier[]
  tables                 RestaurantTable[]
  orders                 Order[]
  orderItems             OrderItem[]
  orderStatusHistories   OrderStatusHistory[]
  idempotencyKeys        IdempotencyKey[]
  customers              Customer[]
  customerAddresses      CustomerAddress[]
  customerPhones         CustomerPhone[]
  tableSessions          TableSession[]
  whatsappConnections    WhatsAppConnection[]
  whatsappMessages       WhatsAppMessage[]
  webhookEvents          WebhookEvent[]
  whatsappConversations  WhatsAppConversation[]
  inboxConversations     InboxConversation[]
  inboxMessages          InboxMessage[]
  coupons                Coupon[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs              AuditLog[]

  @@index([status])
  @@map("restaurants")
}

model Branch {
  id           String       @id @default(cuid())
  restaurantId String       @map("restaurant_id")
  name         String
  code         String
  address      String?
  phone        String?
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  street       String?
  city         String?
  state        String?
  postalCode   String?      @map("postal_code")
  status       BranchStatus @default(ACTIVE)
  isMain       Boolean      @default(false) @map("is_main")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employees      Employee[]
  branchAccesses EmployeeBranchAccess[]
  workingHours   WorkingHours[]
  settings       BranchSettings?
  tables         RestaurantTable[]
  orders         Order[]
  tableSessions  TableSession[]
  coupons        Coupon[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("branches")
}

model WorkingHours {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  branchId     String   @map("branch_id")
  day          Weekday
  openTime     String   @map("open_time")
  closeTime    String   @map("close_time")
  isOpen       Boolean  @default(true) @map("is_open")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, day])
  @@index([restaurantId])
  @@index([branchId])
  @@map("working_hours")
}

model BranchSettings {
  id                   String   @id @default(cuid())
  restaurantId         String   @map("restaurant_id")
  branchId             String   @unique @map("branch_id")
  currency             String?
  timezone             String?
  dailyOrderStartNumber Int      @default(200) @map("daily_order_start_number")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("branch_settings")
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  name         String
  description  String?
  sortOrder    Int        @default(0) @map("sort_order")
  status       MenuStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, deletedAt])
  @@map("categories")
}

model Product {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  categoryId   String     @map("category_id")
  name         String
  description  String?
  price        Decimal    @db.Decimal(10, 2)
  imageUrl     String?    @map("image_url")
  isAvailable  Boolean    @default(true) @map("is_available")
  status       MenuStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifiers  ProductModifier[]
  orderItems OrderItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, status])
  @@index([restaurantId, deletedAt])
  @@map("products")
}

model ProductModifier {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  productId    String    @map("product_id")
  name         String
  priceDelta   Decimal   @default(0.00) @map("price_delta") @db.Decimal(10, 2)
  isRequired   Boolean   @default(false) @map("is_required")
  quantityMode String    @default("SINGLE") @map("quantity_mode") // SINGLE | QUANTITY
  maxQuantity  Int       @default(10) @map("max_quantity")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([productId])
  @@index([restaurantId, deletedAt])
  @@index([productId, deletedAt])
  @@map("product_modifiers")
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  branchId     String      @map("branch_id")
  label        String
  capacity     Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  qrToken      String      @unique @map("qr_token")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders     Order[]
  sessions   TableSession[]

  @@unique([branchId, label])
  @@index([restaurantId])
  @@index([branchId])
  @@index([branchId, status])
  @@index([restaurantId, deletedAt])
  @@index([branchId, deletedAt])
  @@map("tables")
}

model TableSession {
  id                   String    @id @default(cuid())
  restaurantId         String    @map("restaurant_id")
  branchId             String    @map("branch_id")
  tableId              String    @map("table_id")
  pinHash              String    @map("pin_hash")
  pin                  String?   @map("pin") // plaintext PIN (staff-only retrieval; pinHash is used for auth)
  status               String    @default("ACTIVE") @map("status") // ACTIVE | AWAITING_CONFIRMATION | CONFIRMED | CLOSED
  failedAttempts       Int       @default(0) @map("failed_attempts")
  lockoutLevel         Int       @default(0) @map("lockout_level")
  lockoutUntil         DateTime? @map("lockout_until")
  createdByEmployeeId  String?   @map("created_by_employee_id")
  confirmedOrderId     String?   @map("confirmed_order_id")
  closedAt             DateTime? @map("closed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      RestaurantTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  members    TableSessionMember[]
  items      TableSessionItem[]
  orders     TableSessionOrder[]
  waiterCalls TableSessionWaiterCall[]

  @@index([restaurantId, tableId, status])
  @@index([restaurantId, status])
  @@map("table_sessions")
}

model TableSessionMember {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  name      String
  joinedAt  DateTime @default(now()) @map("joined_at")

  session    TableSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  waiterCalls TableSessionWaiterCall[]

  @@index([sessionId])
  @@map("table_session_members")
}

model TableSessionItem {
  id             String              @id @default(cuid())
  sessionId      String              @map("session_id")
  sessionOrderId String?             @map("session_order_id")
  productId      String              @map("product_id")
  productName    String              @map("product_name")
  unitPrice      Decimal             @map("unit_price") @db.Decimal(10, 2)
  quantity       Int                 @default(1)
  addedByName    String?             @map("added_by_name")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  session      TableSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionOrder TableSessionOrder? @relation(fields: [sessionOrderId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("table_session_items")
}

model TableSessionWaiterCall {
  id                   String    @id @default(cuid())
  restaurantId         String    @map("restaurant_id")
  branchId             String    @map("branch_id")
  sessionId            String    @map("session_id")
  tableId              String    @map("table_id")
  memberId             String    @map("member_id")
  requesterName        String    @map("requester_name")
  note                 String?   @map("note")
  type                 String    @default("HELP") @map("type") // HELP | BILL | OTHER
  status               String    @default("PENDING") @map("status") // PENDING | ACCEPTED | DISMISSED
  acceptedByEmployeeId String?   @map("accepted_by_employee_id")
  acceptedAt           DateTime? @map("accepted_at")
  dismissedAt          DateTime? @map("dismissed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  session TableSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  TableSessionMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([restaurantId, branchId, status])
  @@map("table_session_waiter_calls")
}

model TableSessionOrder {
  id          String                @id @default(cuid())
  sessionId   String                @map("session_id")
  orderNumber Int                   @map("order_number")
  status      TableSessionOrderStatus @default(AWAITING_CONFIRMATION) @map("status")
  total       Decimal               @default(0) @map("total") @db.Decimal(10, 2)
  orderId     String?               @map("order_id")
  confirmedAt DateTime?             @map("confirmed_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  session TableSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items   TableSessionItem[]

  @@unique([sessionId, orderNumber])
  @@index([sessionId])
  @@map("table_session_orders")
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    Int           @map("order_number")
  orderDate      String        @map("order_date") // YYYY-MM-DD (branch timezone); number resets daily
  restaurantId   String        @map("restaurant_id")
  branchId       String        @map("branch_id")
  source         OrderSource   @default(CASHIER)
  type           OrderType     @default(DINE_IN)
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod  PaymentMethod? @map("payment_method")
  customerId     String?       @map("customer_id")
  tableId        String?       @map("table_id")
  couponId       String?       @map("coupon_id")
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  address        String?       @map("address")
  cancelReason   String?       @map("cancel_reason")
  paidAt         DateTime?     @map("paid_at")
  paidByEmployeeId String?     @map("paid_by_employee_id")
  refundedAt     DateTime?     @map("refunded_at")
  refundReason   String?       @map("refund_reason")
  refundedByEmployeeId String? @map("refunded_by_employee_id")
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table         RestaurantTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon        Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([branchId, orderDate, orderNumber])
  @@index([restaurantId])
  @@index([branchId])
  @@index([restaurantId, branchId, status])
  @@index([branchId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  restaurantId      String   @map("restaurant_id")
  orderId            String   @map("order_id")
  productId         String   @map("product_id")
  productName       String   @map("product_name")
  quantity          Int      @default(1)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(10, 2)
  notes             String?
  selectedModifiers Json?    @map("selected_modifiers")
  round             Int      @default(1) @map("round") // table-session order round (1 = first)
  createdAt         DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  orderId      String      @map("order_id")
  fromStatus   OrderStatus? @map("from_status")
  toStatus     OrderStatus @map("to_status")
  changedById  String?     @map("changed_by_id")
  reason       String?
  createdAt    DateTime    @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@map("order_status_history")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  key          String
  responseBody Json     @map("response_body")
  statusCode   Int      @default(201) @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("idempotency_keys")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  name         String
  description  String?
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  employees   Employee[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([restaurantId])
  @@index([roleId])
  @@map("role_permissions")
}

model Employee {
  id           String         @id @default(cuid())
  restaurantId String         @map("restaurant_id")
  branchId     String         @map("branch_id")
  roleId       String         @map("role_id")
  name         String
  email        String
  phone        String?
  passwordHash String         @map("password_hash")
  status       EmployeeStatus @default(ACTIVE)
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  role           Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions       Session[]
  branchAccesses EmployeeBranchAccess[]
  assignedInboxConversations InboxConversation[] @relation("inbox_assigned_agent")
  inboxMessages  InboxMessage[] @relation("inbox_message_agent")
  lockedInboxConversations InboxConversation[] @relation("inbox_locked_by")
  notifications  Notification[] @relation("notification_target")
  notificationPreference NotificationPreference? @relation("notification_pref")
  auditLogs      AuditLog[] @relation("audit_actor")

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, status])
  @@index([restaurantId, deletedAt])
  @@map("employees")
}

model Session {
  id               String        @id @default(cuid())
  restaurantId     String        @map("restaurant_id")
  employeeId       String        @map("employee_id")
  device           String
  ipAddress        String        @map("ip_address")
  status           SessionStatus @default(ACTIVE)
  refreshTokenHash String        @unique @map("refresh_token_hash")
  loginAt          DateTime      @default(now()) @map("login_at")
  logoutAt         DateTime?     @map("logout_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, employeeId, status])
  @@map("sessions")
}

model EmployeeBranchAccess {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  employeeId   String   @map("employee_id")
  branchId     String   @map("branch_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  @@index([restaurantId])
  @@index([employeeId])
  @@map("employee_branch_accesses")
}

model Customer {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  name         String
  phone        String
  notes        String?
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  phones     CustomerPhone[]
  addresses  CustomerAddress[]
  orders     Order[]
  conversations WhatsAppConversation[]
  inboxConversations InboxConversation[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, firstName])
  @@index([restaurantId, phone])
  @@index([restaurantId, deletedAt])
  @@map("customers")
}

model CustomerPhone {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  customerId   String   @map("customer_id")
  phone        String
  isDefault    Boolean  @default(false) @map("is_default")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([customerId])
  @@map("customer_phones")
}

model CustomerAddress {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  customerId   String    @map("customer_id")
  label        String    @default("HOME")
  street       String?
  city         String?
  state        String?
  postalCode   String?   @map("postal_code")
  isDefault    Boolean   @default(false) @map("is_default")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([customerId])
  @@index([customerId, deletedAt])
  @@map("customer_addresses")
}

enum ConnectionStatus {
  ACTIVE
  DISCONNECTED
  FAILED
}

enum ConnectionProvider {
  META
  MOCK
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  MEDIA
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model WhatsAppConnection {
  id                    String             @id @default(cuid())
  restaurantId          String             @map("restaurant_id")
  status                ConnectionStatus   @default(ACTIVE)
  provider              ConnectionProvider @default(META)
  providerAccountId     String             @map("provider_account_id")
  providerPhoneNumberId String             @map("provider_phone_number_id")
  displayName           String?            @map("display_name")
  apiToken              String?            @map("api_token") @db.Text
  webhookSecret         String?            @map("webhook_secret") @db.Text
  verifyToken           String?            @map("verify_token")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  messages   WhatsAppMessage[]
  conversations WhatsAppConversation[]

  @@unique([restaurantId, providerAccountId])
  @@index([restaurantId])
  @@index([providerPhoneNumberId])
  @@index([verifyToken])
  @@map("whatsapp_connections")
}

model WhatsAppMessage {
  id                String           @id @default(cuid())
  restaurantId      String           @map("restaurant_id")
  connectionId      String           @map("connection_id")
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  fromPhone         String           @map("from_phone")
  toPhone           String           @map("to_phone")
  content           String?          @db.Text
  mediaUrl          String?          @map("media_url")
  providerMessageId String?          @map("provider_message_id")
  status            MessageStatus    @default(PENDING)
  timestamp         DateTime         @default(now())
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, providerMessageId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, direction])
  @@index([restaurantId, status])
  @@map("whatsapp_messages")
}

model WebhookEvent {
  id           String             @id @default(cuid())
  restaurantId String             @map("restaurant_id")
  eventId      String             @map("event_id")
  provider     ConnectionProvider @default(META)
  rawPayload   Json               @map("raw_payload")
  status       WebhookEventStatus @default(RECEIVED)
  attempts     Int                @default(0)
  lastError    String?            @map("last_error") @db.Text
  processedAt  DateTime?          @map("processed_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, eventId])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("webhook_events")
}

enum WhatsAppFlowState {
  WELCOME
  MAIN_MENU
  MENU_CATEGORY
  PRODUCT_SELECT
  CART
  ADDRESS
  CONFIRM_ORDER
  TRACKING
  FAQ
  HUMAN_HANDOFF
}

enum WhatsAppConversationStatus {
  ACTIVE
  WAITING_AGENT
  CLOSED
}

model WhatsAppConversation {
  id                 String                     @id @default(cuid())
  restaurantId       String                     @map("restaurant_id")
  connectionId       String                     @map("connection_id")
  customerPhone      String                     @map("customer_phone")
  customerId         String?                    @map("customer_id")
  state              WhatsAppFlowState          @default(WELCOME)
  status             WhatsAppConversationStatus @default(ACTIVE)
  cart               Json?                      @default("[]")
  address            String?                    @db.Text
  selectedCategoryId String?                    @map("selected_category_id")
  lastInboundAt      DateTime                   @default(now()) @map("last_inbound_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  inboxConversation InboxConversation?

  @@unique([restaurantId, connectionId, customerPhone])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, customerPhone])
  @@map("whatsapp_conversations")
}

enum InboxStatus {
  WAITING
  ACTIVE
  PENDING
  RESOLVED
  CLOSED
}

enum InboxSenderType {
  AGENT
  CUSTOMER
  SYSTEM
}

model InboxConversation {
  id                     String      @id @default(cuid())
  restaurantId           String      @map("restaurant_id")
  whatsappConversationId String?     @unique @map("whatsapp_conversation_id")
  customerId             String?     @map("customer_id")
  customerPhone          String      @map("customer_phone")
  assignedAgentId        String?     @map("assigned_agent_id")
  relatedOrderId         String?     @map("related_order_id")
  lockedById             String?     @map("locked_by_id")
  lockedAt               DateTime?   @map("locked_at")
  status                 InboxStatus @default(WAITING)
  lastMessageAt          DateTime    @default(now()) @map("last_message_at")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  restaurant            Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  whatsappConversation  WhatsAppConversation? @relation(fields: [whatsappConversationId], references: [id], onDelete: SetNull)
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedAgent         Employee?             @relation("inbox_assigned_agent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  lockedBy              Employee?             @relation("inbox_locked_by", fields: [lockedById], references: [id], onDelete: SetNull)
  messages              InboxMessage[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, assignedAgentId])
  @@index([restaurantId, whatsappConversationId])
  @@map("inbox_conversations")
}

model InboxMessage {
  id             String          @id @default(cuid())
  restaurantId   String          @map("restaurant_id")
  conversationId String          @map("conversation_id")
  senderType     InboxSenderType @default(AGENT)
  content        String          @db.Text
  isInternal     Boolean         @default(false) @map("is_internal")
  agentId        String?         @map("agent_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Employee?        @relation("inbox_message_agent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([conversationId])
  @@map("inbox_messages")
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id                  String     @id @default(cuid())
  restaurantId        String     @map("restaurant_id")
  branchId            String?    @map("branch_id")
  code                String
  type                CouponType @default(PERCENTAGE)
  value               Decimal    @db.Decimal(10, 2)
  minSubtotal         Decimal    @default(0.00) @map("min_subtotal") @db.Decimal(10, 2)
  maxDiscount         Decimal?   @map("max_discount") @db.Decimal(10, 2)
  applicableProductIds Json?     @map("applicable_product_ids")
  usageLimit          Int?       @map("usage_limit")
  timesUsed           Int        @default(0) @map("times_used")
  startsAt            DateTime?  @map("starts_at")
  expiresAt           DateTime?  @map("expires_at")
  isActive            Boolean    @default(true) @map("is_active")
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders     Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, deletedAt])
  @@map("coupons")
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_PAID
  CHAT_ASSIGNED
  CHAT_MESSAGE
  SYSTEM
}

model Notification {
  id               String           @id @default(cuid())
  restaurantId     String           @map("restaurant_id")
  branchId         String?          @map("branch_id")
  targetEmployeeId String           @map("target_employee_id")
  type             NotificationType
  title            String
  body             String           @db.Text
  referenceType    String?          @map("reference_type")
  referenceId      String?          @map("reference_id")
  isRead           Boolean          @default(false) @map("is_read")
  readAt           DateTime?        @map("read_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch         Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  targetEmployee Employee   @relation("notification_target", fields: [targetEmployeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([targetEmployeeId, isRead])
  @@index([restaurantId, targetEmployeeId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  employeeId   String   @unique @map("employee_id")
  disabledTypes Json    @default("[]") @map("disabled_types")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee   Employee   @relation("notification_pref", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("notification_preferences")
}

model AuditLog {
  id              String   @id @default(cuid())
  restaurantId    String   @map("restaurant_id")
  branchId        String?  @map("branch_id")
  actorEmployeeId String?  @map("actor_employee_id")
  action          String
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  metadata        Json?
  ipAddress       String?  @map("ip_address")
  createdAt       DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor      Employee?  @relation("audit_actor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantId, action])
  @@index([restaurantId, entityType, entityId])
  @@index([restaurantId, createdAt])
  @@map("audit_logs")
}