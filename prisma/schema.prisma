generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  ENDED
  FORCE_LOGGED_OUT
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum MenuStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderSource {
  WHATSAPP
  QR
  WEBSITE
  CASHIER
  PHONE
}

enum OrderType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

model Restaurant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  email       String?
  phone       String?
  description String?
  logoUrl     String?          @map("logo_url")
  currency    String?
  timezone    String?
  status      RestaurantStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  branches               Branch[]
  roles                  Role[]
  rolePermissions        RolePermission[]
  employees              Employee[]
  sessions               Session[]
  employeeBranchAccesses EmployeeBranchAccess[]
  workingHours           WorkingHours[]
  branchSettings         BranchSettings[]
  categories             Category[]
  products               Product[]
  productModifiers       ProductModifier[]
  tables                 RestaurantTable[]
  orders                 Order[]
  orderItems             OrderItem[]
  orderStatusHistories   OrderStatusHistory[]
  idempotencyKeys        IdempotencyKey[]
  customers              Customer[]
  customerAddresses      CustomerAddress[]
  whatsappConnections    WhatsAppConnection[]
  whatsappMessages       WhatsAppMessage[]
  webhookEvents          WebhookEvent[]
  whatsappConversations  WhatsAppConversation[]
  inboxConversations     InboxConversation[]
  inboxMessages          InboxMessage[]
  coupons                Coupon[]

  @@index([status])
  @@map("restaurants")
}

model Branch {
  id           String       @id @default(cuid())
  restaurantId String       @map("restaurant_id")
  name         String
  code         String
  address      String?
  phone        String?
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  street       String?
  city         String?
  state        String?
  postalCode   String?      @map("postal_code")
  status       BranchStatus @default(ACTIVE)
  isMain       Boolean      @default(false) @map("is_main")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employees      Employee[]
  branchAccesses EmployeeBranchAccess[]
  workingHours   WorkingHours[]
  settings       BranchSettings?
  tables         RestaurantTable[]
  orders         Order[]
  coupons        Coupon[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("branches")
}

model WorkingHours {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  branchId     String   @map("branch_id")
  day          Weekday
  openTime     String   @map("open_time")
  closeTime    String   @map("close_time")
  isOpen       Boolean  @default(true) @map("is_open")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, day])
  @@index([restaurantId])
  @@index([branchId])
  @@map("working_hours")
}

model BranchSettings {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  branchId     String   @unique @map("branch_id")
  currency     String?
  timezone     String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("branch_settings")
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  name         String
  description  String?
  sortOrder    Int        @default(0) @map("sort_order")
  status       MenuStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("categories")
}

model Product {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  categoryId   String     @map("category_id")
  name         String
  description  String?
  price        Decimal    @db.Decimal(10, 2)
  imageUrl     String?    @map("image_url")
  isAvailable  Boolean    @default(true) @map("is_available")
  status       MenuStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifiers  ProductModifier[]
  orderItems OrderItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, status])
  @@map("products")
}

model ProductModifier {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  productId    String    @map("product_id")
  name         String
  priceDelta   Decimal   @default(0.00) @map("price_delta") @db.Decimal(10, 2)
  isRequired   Boolean   @default(false) @map("is_required")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([productId])
  @@map("product_modifiers")
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  branchId     String      @map("branch_id")
  label        String
  capacity     Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  qrToken      String      @unique @map("qr_token")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([branchId, label])
  @@index([restaurantId])
  @@index([branchId])
  @@index([branchId, status])
  @@map("tables")
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    Int           @map("order_number")
  restaurantId   String        @map("restaurant_id")
  branchId       String        @map("branch_id")
  source         OrderSource   @default(CASHIER)
  type           OrderType     @default(DINE_IN)
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod  PaymentMethod? @map("payment_method")
  customerId     String?       @map("customer_id")
  tableId        String?       @map("table_id")
  couponId       String?       @map("coupon_id")
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  cancelReason   String?       @map("cancel_reason")
  paidAt         DateTime?     @map("paid_at")
  paidByEmployeeId String?     @map("paid_by_employee_id")
  refundedAt     DateTime?     @map("refunded_at")
  refundReason   String?       @map("refund_reason")
  refundedByEmployeeId String? @map("refunded_by_employee_id")
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table         RestaurantTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon        Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([branchId, orderNumber])
  @@index([restaurantId])
  @@index([branchId])
  @@index([restaurantId, branchId, status])
  @@index([branchId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  restaurantId      String   @map("restaurant_id")
  orderId            String   @map("order_id")
  productId         String   @map("product_id")
  productName       String   @map("product_name")
  quantity          Int      @default(1)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(10, 2)
  notes             String?
  selectedModifiers Json?    @map("selected_modifiers")
  createdAt         DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  orderId      String      @map("order_id")
  fromStatus   OrderStatus? @map("from_status")
  toStatus     OrderStatus @map("to_status")
  changedById  String?     @map("changed_by_id")
  reason       String?
  createdAt    DateTime    @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@map("order_status_history")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  key          String
  responseBody Json     @map("response_body")
  statusCode   Int      @default(201) @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("idempotency_keys")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  name         String
  description  String?
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  employees   Employee[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([restaurantId])
  @@index([roleId])
  @@map("role_permissions")
}

model Employee {
  id           String         @id @default(cuid())
  restaurantId String         @map("restaurant_id")
  branchId     String         @map("branch_id")
  roleId       String         @map("role_id")
  name         String
  email        String
  phone        String?
  passwordHash String         @map("password_hash")
  status       EmployeeStatus @default(ACTIVE)
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  role           Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions       Session[]
  branchAccesses EmployeeBranchAccess[]
  assignedInboxConversations InboxConversation[] @relation("inbox_assigned_agent")
  inboxMessages  InboxMessage[] @relation("inbox_message_agent")
  lockedInboxConversations InboxConversation[] @relation("inbox_locked_by")

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, status])
  @@map("employees")
}

model Session {
  id               String        @id @default(cuid())
  restaurantId     String        @map("restaurant_id")
  employeeId       String        @map("employee_id")
  device           String
  ipAddress        String        @map("ip_address")
  status           SessionStatus @default(ACTIVE)
  refreshTokenHash String        @unique @map("refresh_token_hash")
  loginAt          DateTime      @default(now()) @map("login_at")
  logoutAt         DateTime?     @map("logout_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, employeeId, status])
  @@map("sessions")
}

model EmployeeBranchAccess {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  employeeId   String   @map("employee_id")
  branchId     String   @map("branch_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  @@index([restaurantId])
  @@index([employeeId])
  @@map("employee_branch_accesses")
}

model Customer {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  name         String
  phone        String
  email        String?
  notes        String?
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  addresses  CustomerAddress[]
  orders     Order[]
  conversations WhatsAppConversation[]
  inboxConversations InboxConversation[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, name])
  @@index([restaurantId, phone])
  @@map("customers")
}

model CustomerAddress {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  customerId   String    @map("customer_id")
  label        String    @default("HOME")
  street       String?
  city         String?
  state        String?
  postalCode   String?   @map("postal_code")
  isDefault    Boolean   @default(false) @map("is_default")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([customerId])
  @@map("customer_addresses")
}

enum ConnectionStatus {
  ACTIVE
  DISCONNECTED
  FAILED
}

enum ConnectionProvider {
  META
  MOCK
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  MEDIA
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model WhatsAppConnection {
  id                    String             @id @default(cuid())
  restaurantId          String             @map("restaurant_id")
  status                ConnectionStatus   @default(ACTIVE)
  provider              ConnectionProvider @default(META)
  providerAccountId     String             @map("provider_account_id")
  providerPhoneNumberId String             @map("provider_phone_number_id")
  displayName           String?            @map("display_name")
  webhookSecret         String?            @map("webhook_secret")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  messages   WhatsAppMessage[]
  conversations WhatsAppConversation[]

  @@unique([restaurantId, providerAccountId])
  @@index([restaurantId])
  @@index([providerPhoneNumberId])
  @@map("whatsapp_connections")
}

model WhatsAppMessage {
  id                String           @id @default(cuid())
  restaurantId      String           @map("restaurant_id")
  connectionId      String           @map("connection_id")
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  fromPhone         String           @map("from_phone")
  toPhone           String           @map("to_phone")
  content           String?          @db.Text
  mediaUrl          String?          @map("media_url")
  providerMessageId String?          @map("provider_message_id")
  status            MessageStatus    @default(PENDING)
  timestamp         DateTime         @default(now())
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, providerMessageId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, direction])
  @@index([restaurantId, status])
  @@map("whatsapp_messages")
}

model WebhookEvent {
  id           String             @id @default(cuid())
  restaurantId String             @map("restaurant_id")
  eventId      String             @map("event_id")
  provider     ConnectionProvider @default(META)
  rawPayload   Json               @map("raw_payload")
  status       WebhookEventStatus @default(RECEIVED)
  attempts     Int                @default(0)
  lastError    String?            @map("last_error") @db.Text
  processedAt  DateTime?          @map("processed_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, eventId])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("webhook_events")
}

enum WhatsAppFlowState {
  WELCOME
  MAIN_MENU
  MENU_CATEGORY
  PRODUCT_SELECT
  CART
  ADDRESS
  CONFIRM_ORDER
  TRACKING
  FAQ
  HUMAN_HANDOFF
}

enum WhatsAppConversationStatus {
  ACTIVE
  WAITING_AGENT
  CLOSED
}

model WhatsAppConversation {
  id                 String                     @id @default(cuid())
  restaurantId       String                     @map("restaurant_id")
  connectionId       String                     @map("connection_id")
  customerPhone      String                     @map("customer_phone")
  customerId         String?                    @map("customer_id")
  state              WhatsAppFlowState          @default(WELCOME)
  status             WhatsAppConversationStatus @default(ACTIVE)
  cart               Json?                      @default("[]")
  address            String?                    @db.Text
  selectedCategoryId String?                    @map("selected_category_id")
  lastInboundAt      DateTime                   @default(now()) @map("last_inbound_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  inboxConversation InboxConversation?

  @@unique([restaurantId, connectionId, customerPhone])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, customerPhone])
  @@map("whatsapp_conversations")
}

enum InboxStatus {
  WAITING
  ACTIVE
  PENDING
  RESOLVED
  CLOSED
}

enum InboxSenderType {
  AGENT
  CUSTOMER
  SYSTEM
}

model InboxConversation {
  id                     String      @id @default(cuid())
  restaurantId           String      @map("restaurant_id")
  whatsappConversationId String?     @unique @map("whatsapp_conversation_id")
  customerId             String?     @map("customer_id")
  customerPhone          String      @map("customer_phone")
  assignedAgentId        String?     @map("assigned_agent_id")
  relatedOrderId         String?     @map("related_order_id")
  lockedById             String?     @map("locked_by_id")
  lockedAt               DateTime?   @map("locked_at")
  status                 InboxStatus @default(WAITING)
  lastMessageAt          DateTime    @default(now()) @map("last_message_at")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  restaurant            Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  whatsappConversation  WhatsAppConversation? @relation(fields: [whatsappConversationId], references: [id], onDelete: SetNull)
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedAgent         Employee?             @relation("inbox_assigned_agent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  lockedBy              Employee?             @relation("inbox_locked_by", fields: [lockedById], references: [id], onDelete: SetNull)
  messages              InboxMessage[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, assignedAgentId])
  @@index([restaurantId, whatsappConversationId])
  @@map("inbox_conversations")
}

model InboxMessage {
  id             String          @id @default(cuid())
  restaurantId   String          @map("restaurant_id")
  conversationId String          @map("conversation_id")
  senderType     InboxSenderType @default(AGENT)
  content        String          @db.Text
  isInternal     Boolean         @default(false) @map("is_internal")
  agentId        String?         @map("agent_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Employee?        @relation("inbox_message_agent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([conversationId])
  @@map("inbox_messages")
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id                  String     @id @default(cuid())
  restaurantId        String     @map("restaurant_id")
  branchId            String?    @map("branch_id")
  code                String
  type                CouponType @default(PERCENTAGE)
  value               Decimal    @db.Decimal(10, 2)
  minSubtotal         Decimal    @default(0.00) @map("min_subtotal") @db.Decimal(10, 2)
  maxDiscount         Decimal?   @map("max_discount") @db.Decimal(10, 2)
  applicableProductIds Json?     @map("applicable_product_ids")
  usageLimit          Int?       @map("usage_limit")
  timesUsed           Int        @default(0) @map("times_used")
  startsAt            DateTime?  @map("starts_at")
  expiresAt           DateTime?  @map("expires_at")
  isActive            Boolean    @default(true) @map("is_active")
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders     Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("coupons")
}